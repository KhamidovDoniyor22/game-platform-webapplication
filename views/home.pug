extends layout

block content
  // Hero Section
  .container.mt-5
    .row.align-items-center
      // Left Column: Illustration
      .col-md-6.mb-4.mb-md-0
        img.img-fluid(src="/images/logo.png", alt="XDL", style="max-height: 350px; object-fit: cover;")
      // Right Column: Text and Button
      .col-md-6
        h1.mb-3 Welcome to XDL Gaming!
        p.lead
          | GameAssist empowers you to effortlessly play games online, leave comments, view upcoming gaming 
          | events, book your spot, and follow the communities you love. Our intuitive platform is designed to 
          | keep you connected with the latest in gaming, offering real-time updates, interactive forums, and 
          | personalized recommendations to enhance every aspect of your gaming journey.
        a.btn.btn-primary.btn-lg(href="/signup") Get Started

  // Feature Section
  .container.mt-5
    .row
      // First Feature Card
      .col-md-6.mb-4
        .card.shadow-sm.border-0
          .row.g-0
            .col-4
              img.card-img-left.img-fluid(src="/images/Play&Connect.png", alt="Play Connect", style="height: 100%; object-fit: cover;")
            .col-8
              .card-body
                h4.card-title Play & Connect
                p.card-text Keep an eye on all your gaming in one place.

      // Second Feature Card
      .col-md-6.mb-4
        .card.shadow-sm.border-0
          .row.g-0
            .col-4
              img.card-img-left.img-fluid(src="/images/ViewEvents.png", alt="View Events", style="height: 100%; object-fit: cover;")
            .col-8
              .card-body
                h4.card-title View Events!
                p.card-text Follow the favourite communitieas and also be aware about interesting events!
