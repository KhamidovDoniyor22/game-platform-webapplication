extends layout

block content
  h1.text-center.mb-4.fw-bold.text-dark Communities
  .list-group
    each community in communities
      .list-group-item.d-flex.justify-content-between.align-items-center
        .d-flex.align-items-center
          img.rounded-circle(
            src= community.imageUrl ? community.imageUrl : ("https://picsum.photos/seed/community-" + community.id + "/50/50"),
            alt= community.name,
            style="width: 50px; height: 50px; object-fit: cover;"
          )
          .ms-3
            h5.mb-0= community.name
            p.text-muted.small.mb-0= community.description
            p.text-muted.small.mb-0 Members: #{community.members.length}
        if followedCommunities && followedCommunities.indexOf(community.id) > -1
          form(method="POST", action=`/communities/${community.id}/follow`)
            button.btn.btn-danger.btn-sm(type="submit") Unfollow
        else
          form(method="POST", action=`/communities/${community.id}/follow`)
            button.btn.btn-primary.btn-sm(type="submit") Follow
