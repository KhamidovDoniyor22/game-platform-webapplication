extends layout

block content
  h1.text-center.mb-4= community.name
  img.img-fluid.mb-3(
    src= community.imageUrl ? community.imageUrl : ("https://picsum.photos/seed/community-" + community.id + "/800/400"),
    alt= community.name,
    style="object-fit: cover; width: 100%; max-height: 400px;"
  )
  p.lead= community.description
  p= community.history
  p Members: #{community.members.length}
  a.btn.btn-secondary.mt-3(href="/communities") Back to Communities
