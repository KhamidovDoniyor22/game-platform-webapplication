extends layout

block content
  h1.text-center.mb-4 All Games
  .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
    each game in games
      .col
        .card.h-100.shadow-sm.rounded
          // Game Image
          img.card-img-top(
            src= game.imageUrl ? game.imageUrl : ("https://picsum.photos/seed/game-" + game.id + "/400/250"),
            alt= game.title,
             style="object-fit: contain; width: 100%; max-height: 250px;"
             )

          // Card Body
          .card-body
            h5.card-title.text-center= game.title
            p.card-text.text-center.text-muted= game.description.substring(0, 100) + "..."
          // Card Footer
          .card-footer.text-center
            a.btn.btn-primary(href=`/games/${game.id}`) View Details
