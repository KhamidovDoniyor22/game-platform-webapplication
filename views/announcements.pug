extends layout

block content
  h1.text-center.mb-4 Epic Events

  // First row: Hot Events (3 events)
  .row.mb-2
    .col-12
      h4.text-start.text-dark.mb-2(style="font-size: 1rem;") Hot Events
  .row.row-cols-1.row-cols-md-3.g-4.mb-4
    each event in announcements.slice(0, 3)
      .col
        .card.h-100.shadow-sm.rounded.event-card(style="overflow: hidden; position: relative; transition: transform 0.3s;")
          a(href=`/announcements/${event.id}` style="text-decoration: none; color: inherit; display: block;")
            .position-relative
              img.card-img-top(
                src= event.imageUrl ? event.imageUrl : ("https://picsum.photos/seed/event-" + event.id + "/400/250"), 
                alt= event.title,
                style="object-fit: cover; width: 100%; transition: transform 0.3s; max-height: 180px;"
              )
              // Optional badge for "Hot!"
              .badge.bg-danger.position-absolute.top-0.start-0.ms-1.mt-1(style="font-size: 0.7rem;") Hot!
            .card-body
              h6.card-title.mb-2.text-center.fw-bold= event.title
              p.card-text.text-center.text-muted= event.shortDescription.substring(0, 60) + "..."
          // Footer with participants, date, and prize
          .card-footer.bg-light.p-2.d-flex.justify-content-around
            // Participants (bookings)
            .info-box
              small.text-muted
                | 👥 
                = (event.bookings ? event.bookings.length : 0) + " in"
            // Event date
            .info-box
              small.text-muted
                | 📅 
                = event.eventDate ? event.eventDate : "N/A"
            // Prize
            .info-box
              small.text-muted
                | 💰 
                = (event.prize != null ? event.prize : 0)

  // Second row: Sport Events (5 events)
  .row.mb-2
    .col-12
      h4.text-start.text-dark.mb-2(style="font-size: 1rem;") Sport Events
  .row.row-cols-1.row-cols-md-5.g-2.mb-4
    each event in announcements.slice(3, 8)
      .col
        .card.h-100.shadow-sm.rounded.event-card(style="overflow: hidden; position: relative; transition: transform 0.3s;")
          a(href=`/announcements/${event.id}` style="text-decoration: none; color: inherit; display: block;")
            .position-relative
              img.card-img-top(
                src= event.imageUrl ? event.imageUrl : ("https://picsum.photos/seed/event-" + event.id + "/400/250"), 
                alt= event.title,
                style="object-fit: cover; width: 100%; transition: transform 0.3s; max-height: 150px;"
              )
            .card-body
              h6.card-title.mb-2.text-center.fw-bold= event.title
              p.card-text.text-center.text-muted= event.shortDescription.substring(0, 40) + "..."
          .card-footer.bg-light.p-2.d-flex.justify-content-around
            // Participants
            .info-box
              small.text-muted
                | 👥 
                = (event.bookings ? event.bookings.length : 0) + " in"
            // Date
            .info-box
              small.text-muted
                | 📅 
                = event.eventDate ? event.eventDate : "N/A"
            // Prize
            .info-box
              small.text-muted
                | 💰 
                = (event.prize != null ? event.prize : 0)

  // Third row: General Events (3 events)
  .row.mb-2
    .col-12
      h4.text-start.text-dark.mb-2(style="font-size: 1rem;") General Events
  .row.row-cols-1.row-cols-md-3.g-4.mb-4
    each event in announcements.slice(8)
      .col
        .card.h-100.shadow-sm.rounded.event-card(style="overflow: hidden; position: relative; transition: transform 0.3s;")
          a(href=`/announcements/${event.id}` style="text-decoration: none; color: inherit; display: block;")
            .position-relative
              img.card-img-top(
                src= event.imageUrl ? event.imageUrl : ("https://picsum.photos/seed/event-" + event.id + "/400/250"), 
                alt= event.title,
                style="object-fit: cover; width: 100%; transition: transform 0.3s; max-height: 180px;"
              )
            .card-body
              h6.card-title.mb-2.text-center.fw-bold= event.title
              p.card-text.text-center.text-muted= event.shortDescription.substring(0, 60) + "..."
          .card-footer.bg-light.p-2.d-flex.justify-content-around
            // Participants
            .info-box
              small.text-muted
                | 👥 
                = (event.bookings ? event.bookings.length : 0) + " in"
            // Date
            .info-box
              small.text-muted
                | 📅 
                = event.eventDate ? event.eventDate : "N/A"
            // Prize
            .info-box
              small.text-muted
                | 💰 
                = (event.prize != null ? event.prize : 0)
