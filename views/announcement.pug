extends layout

block content
  .hero-announcement(style="position: relative; height: 300px; overflow: hidden;")
    img.hero-bg(
      src= event.imageUrl ? event.imageUrl : ("https://picsum.photos/seed/event-hero-" + event.id + "/1200/300"),
      alt= event.title,
      style="width: 100%; height: 300px; object-fit: cover;"
    )
    .overlay(style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); pointer-events: none;")
    .hero-content.text-center.text-white(style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2;")
      h1.fw-bold.mb-2= event.title
      p.mb-0
        | 📅 
        = event.eventDate ? event.eventDate : "N/A"
  .container.mt-4
    h3.fw-bold.mb-3 Details
    p.lead.text-muted= event.details || "No details available."
    
    .participants-box.mt-4.p-3.border.rounded
      h4.fw-bold.mb-2 Participants
      - var count = (event.bookings && event.bookings.length) ? event.bookings.length : 0;
      p
        | Currently 
        span.text-success= count
        |  people have booked.
      if count > 0
        ul.list-unstyled
          each email in event.bookings
            li= email
      else
        p.text-muted No participants yet.
    
    .comments-section.mt-4
      h4.fw-bold.mb-3 Comments
      if event.comments && event.comments.length
        each comment in event.comments
          .card.mb-2.shadow-sm
            .card-body
              p
                strong= comment.user
                | : #{comment.text}
              small.text-muted= comment.date
      else
        p.text-muted No comments yet.
    
    .comment-form.mt-4
      h4.fw-bold.mb-3 Leave a Comment
      form(method="POST", action=`/announcements/${event.id}/comment`)
        .mb-3
          label.form-label(for="comment") Your Comment:
          textarea.form-control(name="comment", rows="3", required)
        button.btn.btn-secondary(type="submit") Submit Comment
    
    .booking-section.mt-4.border.rounded.p-3
      h4.fw-bold.mb-3 Book This Event
      if error
        .alert.alert-danger= error
      if success
        .alert.alert-success= success
      form(method="POST", action=`/announcements/${event.id}/book`)
        .mb-3
          label.form-label(for="email") Enter your Email to book:
          input.form-control(type="email", name="email", required, placeholder="you@example.com")
        button.btn.btn-primary(type="submit") Book Now
    
    a.btn.btn-secondary.mt-3(href="/announcements") Back to Events
